#!/bin/sh
# Prije svakog commita povuci najnovije Notes sa Substacka i dodaj notes.json u commit.
# GitHub Actions to ne može jer Substack blokira njihove servere.
# Ako povlačenje ne uspije (npr. nema interneta), commit ide dalje sa starim notes.json.

if python3 scripts/fetch_substack.py; then
  git add notes.json
else
  echo "Upozorenje: Notes sa Substacka nisu osvježeni, commit se nastavlja." >&2
fi

exit 0
